{
  "name": "frontend-proxy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:server": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "npm run typecheck && vite build && tsc -p .",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.client.json",
    "test": "tsc -p tsconfig.tests.json && node --test .test-build/tests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "connect-history-api-fallback": "^2.0.0",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6",
    "vite": "^7.3.7"
  },
  "overrides": {
    "qs": "^6.16.2"
  }
}
